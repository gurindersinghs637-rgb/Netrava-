# ==============================================================================
# NETRAVA Master Environment Variables Template
# Copy this file to .env and configure with your local or cloud values.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
PROJECT_NAME="NETRAVA"
API_V1_STR="/api/v1"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Server Binding
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Supabase Cloud Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=PASTE_PUBLISHABLE_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=PASTE_SECRET_KEY_HERE

# PostgreSQL Connection String (Supabase Direct or Pooler)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Machine Learning & AI Inference
MODEL_NAME=efficientnet_b3
MODEL_CHECKPOINT_PATH=ai_model/checkpoint/best_efficientnet_b3_staged.pth
IMG_SIZE=300
DEVICE=cuda  # Set to 'cpu' if no NVIDIA GPU is available
GRADCAM_TARGET_LAYER=conv_head
GRADCAM_COLORMAP=jet
GRADCAM_ALPHA=0.40

# Quality Control (QC) Thresholds
QC_MIN_LAPLACIAN_VARIANCE=60.0
QC_MIN_BRIGHTNESS=30.0
QC_MAX_BRIGHTNESS=230.0

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8080"]


# Recovery page: HTTPS after deployment; local links must be opened on this PC.
PASSWORD_RESET_REDIRECT_URL=http://127.0.0.1:8000/api/v1/auth/reset-password
